# Environment variables for local development

# Database URL for SQLAlchemy
DATABASE_URL=postgresql://postgres:postgres@db:5432/truthai

# Redis URL (for refresh token store / rate limiting)
REDIS_URL=redis://redis:6379/0

# JWT secret key (use a strong random value in production)
JWT_SECRET=replace-me-with-a-secure-random-string

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Backend host/port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Next.js public API url (frontend uses this)
NEXT_PUBLIC_API_URL=http://localhost:8000
